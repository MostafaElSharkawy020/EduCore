@model EduCore.ViewModels.CardFormViewModel
@{
    ViewData["Title"] = "Add Card";
}

<div class="page-header">
    <nav style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px">
        <a asp-action="Index" style="color:var(--accent2);text-decoration:none">Payment Cards</a>
        <span style="margin:0 8px">›</span>
        <span>Add Card</span>
    </nav>
    <h1 class="page-title">Add Payment Card</h1>
</div>

<form method="post" asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"
         style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="card" style="max-width:520px">
        <div class="form-group">
            <label class="form-label" asp-for="CardholderName">Cardholder Name</label>
            <input class="form-input" asp-for="CardholderName" placeholder="Name on card" />
            <span asp-validation-for="CardholderName" style="color:#ef4444;font-size:.8rem"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="CardNumber">Card Number</label>
            <input class="form-input" asp-for="CardNumber" placeholder="0000 0000 0000 0000" inputmode="numeric" />
            <span asp-validation-for="CardNumber" style="color:#ef4444;font-size:.8rem"></span>
        </div>

        <div class="grid-2">
            <div class="form-group">
                <label class="form-label" asp-for="Expiry">Expiry (MM/YY)</label>
                <input class="form-input" asp-for="Expiry" placeholder="MM/YY" maxlength="5" />
                <span asp-validation-for="Expiry" style="color:#ef4444;font-size:.8rem"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="CVV">CVV</label>
                <input class="form-input" asp-for="CVV" placeholder="123" maxlength="4" inputmode="numeric" />
                <span asp-validation-for="CVV" style="color:#ef4444;font-size:.8rem"></span>
            </div>
        </div>

        <div class="alert alert-info" style="font-size:.82rem">💳 Simulated payment — no real charge is ever made.</div>

        <div style="display:flex;gap:12px">
            <button type="submit" class="btn btn-accent">Save Card</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
