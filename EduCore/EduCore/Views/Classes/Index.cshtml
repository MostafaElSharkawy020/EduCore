@model IEnumerable<EduCore.Models.Class>
@{
    ViewData["Title"] = "Classes";
    var byCourse = Model.GroupBy(c => c.Course?.Name ?? "Unassigned");
}

<div class="page-header flex-between">
    <div>
        <h1 class="page-title">Classes</h1>
        <p class="page-subtitle">All classes across your courses</p>
    </div>
    <a asp-action="Create" class="btn btn-accent">+ New Class</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have no classes yet. Click <strong>+ New Class</strong> to add one to a course.
    </div>
}
else
{
    @foreach (var group in byCourse)
    {
        <div class="card" style="margin-bottom:18px">
            <div style="font-size:.85rem;font-weight:600;color:var(--text-muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.8px">@group.Key</div>
            @foreach (var cls in group)
            {
                <div style="display:flex;align-items:center;gap:14px;padding:13px 0;border-bottom:1px solid var(--border)">
                    <div style="width:38px;height:38px;border-radius:8px;background:var(--surface);display:flex;align-items:center;justify-content:center">📹</div>
                    <div style="flex:1">
                        <div style="font-weight:600;font-size:.9rem">@cls.Name</div>
                        <div style="font-size:.78rem;color:var(--text-muted)">ID: C@cls.ID · @cls.Price.ToString("C")</div>
                    </div>
                    <div class="flex gap-8">
                        <a asp-controller="Videos" asp-action="Index" asp-route-classId="@cls.ID" class="btn btn-blue btn-sm">Videos</a>
                        <a asp-controller="Quizzes" asp-action="Index" asp-route-classId="@cls.ID" class="btn btn-blue btn-sm">Quizzes</a>
                        <a asp-action="Edit" asp-route-id="@cls.ID" class="btn btn-outline btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@cls.ID" class="btn btn-danger btn-sm">Del</a>
                    </div>
                </div>
            }
        </div>
    }
}
