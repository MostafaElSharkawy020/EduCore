@model IEnumerable<EduCore.Models.Quiz>
@{
    var cls = (EduCore.Models.Class)ViewBag.Class;
    ViewData["Title"] = "Quizzes — " + cls.Name;
}

<div class="page-header flex-between">
    <div>
        <nav style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px">
            <a asp-controller="Classes" asp-action="Index" style="color:var(--accent2);text-decoration:none">Classes</a>
            <span style="margin:0 8px">›</span>
            <span>@cls.Name</span>
        </nav>
        <h1 class="page-title">Quizzes</h1>
        <p class="page-subtitle">Quizzes for the class "@cls.Name"</p>
    </div>
    <a asp-action="Create" asp-route-classId="@cls.ID" class="btn btn-accent">+ New Quiz</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No quizzes yet for this class. Click <strong>+ New Quiz</strong> to create one.
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Quiz</th>
                    <th>Questions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quiz in Model)
                {
                    <tr>
                        <td style="font-weight:600">@quiz.Title</td>
                        <td>@quiz.QuizQuestions.Count</td>
                        <td>
                            <div class="flex gap-8">
                                <a asp-action="Details" asp-route-id="@quiz.ID" class="btn btn-blue btn-sm">Manage Questions</a>
                                <a asp-controller="Results" asp-action="Quiz" asp-route-id="@quiz.ID" class="btn btn-outline btn-sm">Results</a>
                                <a asp-action="Edit" asp-route-id="@quiz.ID" class="btn btn-outline btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@quiz.ID" class="btn btn-danger btn-sm">Del</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
