@model EduCore.Models.Quiz
@{
    var cls = (EduCore.Models.Class)ViewBag.Class;
    ViewData["Title"] = "Create Quiz";
}

<div class="page-header">
    <nav style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px">
        <a asp-action="Index" asp-route-classId="@cls.ID" style="color:var(--accent2);text-decoration:none">Quizzes</a>
        <span style="margin:0 8px">›</span>
        <span>New Quiz</span>
    </nav>
    <h1 class="page-title">Create Quiz</h1>
    <p class="page-subtitle">Add a quiz to "@cls.Name"</p>
</div>

<form method="post">
    <div asp-validation-summary="All" style="color:#ef4444;margin-bottom:12px"></div>
    <input type="hidden" asp-for="ClassID" />

    <div class="card" style="max-width:560px">
        <div class="form-group">
            <label class="form-label" asp-for="Title">Quiz Title <span style="color:#ef4444">*</span></label>
            <input class="form-input" asp-for="Title" placeholder="e.g. Class 1 Quiz" />
            <span asp-validation-for="Title" style="color:#ef4444;font-size:.8rem"></span>
        </div>
        <div class="form-group">
            <label class="form-label" asp-for="DurationMinutes">Time Limit (minutes)</label>
            <input class="form-input" asp-for="DurationMinutes" type="number" min="0" max="600" />
            <span asp-validation-for="DurationMinutes" style="color:#ef4444;font-size:.8rem"></span>
            <div class="form-hint">Students must finish within this time. Set to 0 for no limit.</div>
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end">
            <a asp-action="Index" asp-route-classId="@cls.ID" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-accent">Save Quiz</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
