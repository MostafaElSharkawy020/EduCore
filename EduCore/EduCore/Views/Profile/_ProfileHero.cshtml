@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool Tab(string a) => string.Equals(action, a, StringComparison.OrdinalIgnoreCase);

    var name = ViewBag.HeaderName as string ?? "";
    var email = ViewBag.HeaderEmail as string ?? "";
    var roleLabel = ViewBag.HeaderRole as string ?? "";
    var initials = ViewBag.HeaderInitials as string ?? "U";
    if (string.IsNullOrEmpty(initials)) initials = "U";
}

<style>
    .profile-hero { background:var(--primary); border-radius:16px; padding:32px; display:flex; align-items:center; gap:24px; margin-bottom:24px; }
    .profile-avatar-lg { width:84px; height:84px; border-radius:50%; background:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.9rem; font-weight:700; color:#fff; flex-shrink:0; border:3px solid rgba(255,255,255,.2); }
    .profile-info h2 { color:#fff; font-size:1.5rem; margin-bottom:4px; }
    .profile-info p { color:rgba(255,255,255,.6); font-size:.9rem; }
    .tab-bar { display:flex; border-bottom:2px solid var(--border); margin-bottom:24px; gap:4px; }
    .tab { padding:10px 20px; font-family:'DM Sans',sans-serif; font-size:.9rem; font-weight:500; color:var(--text-muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; transition:all .18s; text-decoration:none; }
    .tab:hover { color:var(--primary); }
    .tab.active { color:var(--accent2); border-bottom-color:var(--accent2); font-weight:600; }
</style>

<div class="page-header">
    <h1 class="page-title">My Profile</h1>
    <p class="page-subtitle">Manage your personal information and security</p>
</div>

<div class="profile-hero">
    <div class="profile-avatar-lg">@initials</div>
    <div class="profile-info">
        <h2>@name</h2>
        <p>@email</p>
        <div style="margin-top:10px"><span class="badge badge-blue">@roleLabel</span></div>
    </div>
</div>

<div class="tab-bar">
    <a class="tab @(Tab("Index") ? "active" : "")" asp-action="Index">Personal Info</a>
    <a class="tab @(Tab("Edit") ? "active" : "")" asp-action="Edit">Edit Profile</a>
    <a class="tab @(Tab("Password") ? "active" : "")" asp-action="Password">Password</a>
</div>

@if (TempData["ProfileMessage"] != null)
{
    <div class="alert alert-success">@TempData["ProfileMessage"]</div>
}
