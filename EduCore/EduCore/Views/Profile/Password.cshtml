@model EduCore.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Security";
}

<style>
    .pw-wrap { position:relative; }
    .pw-toggle { position:absolute; right:8px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; font-size:1.05rem; line-height:1; }
</style>

<partial name="_ProfileHero" />

<form method="post" asp-action="Password">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"
         style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="card" style="max-width:500px">
        <h3 style="font-size:1rem;margin-bottom:18px;font-weight:700">Change Password</h3>

        <div class="form-group">
            <label class="form-label" asp-for="CurrentPassword">Current Password</label>
            <div class="pw-wrap">
                <input class="form-input" asp-for="CurrentPassword" type="password" placeholder="••••••••" style="padding-right:44px" />
                <button type="button" class="pw-toggle" aria-label="Show password" onclick="togglePw('CurrentPassword', this)">👁️</button>
            </div>
            <span asp-validation-for="CurrentPassword" style="color:#ef4444;font-size:.8rem"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="NewPassword">New Password</label>
            <div class="pw-wrap">
                <input class="form-input" asp-for="NewPassword" type="password" placeholder="At least 6 characters" style="padding-right:44px" />
                <button type="button" class="pw-toggle" aria-label="Show password" onclick="togglePw('NewPassword', this)">👁️</button>
            </div>
            <span asp-validation-for="NewPassword" style="color:#ef4444;font-size:.8rem"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="ConfirmPassword">Confirm New Password</label>
            <div class="pw-wrap">
                <input class="form-input" asp-for="ConfirmPassword" type="password" placeholder="Repeat new password" style="padding-right:44px" />
                <button type="button" class="pw-toggle" aria-label="Show password" onclick="togglePw('ConfirmPassword', this)">👁️</button>
            </div>
            <span asp-validation-for="ConfirmPassword" style="color:#ef4444;font-size:.8rem"></span>
        </div>

        <button type="submit" class="btn btn-primary">Update Password</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePw(id, btn) {
            var el = document.getElementById(id);
            if (!el) return;
            var show = el.type === 'password';
            el.type = show ? 'text' : 'password';
            btn.textContent = show ? '🙈' : '👁️';
        }
    </script>
}
