@model EduCore.Models.Course
@{
    ViewData["Title"] = "Create Course";
}

<div class="page-header">
    <nav style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px">
        <a asp-action="Index" style="color:var(--accent2);text-decoration:none">Course Management</a>
        <span style="margin:0 8px">›</span>
        <span>New Course</span>
    </nav>
    <h1 class="page-title">Create New Course</h1>
    <p class="page-subtitle">Fill in the details below to publish your course</p>
</div>

<partial name="_CourseForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
