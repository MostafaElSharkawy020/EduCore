@model EduCore.Models.Course
@{
    ViewData["Title"] = "Delete Course";
}

<div class="page-header">
    <nav style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px">
        <a asp-action="Index" style="color:var(--accent2);text-decoration:none">Course Management</a>
        <span style="margin:0 8px">›</span>
        <span>Delete Course</span>
    </nav>
    <h1 class="page-title">Delete Course</h1>
</div>

<div class="card" style="max-width:560px">
    <div class="alert alert-warning">
        Are you sure you want to delete this course? This will also delete all of its classes.
    </div>

    <h3 style="margin-bottom:6px">@Model.Name</h3>
    <p class="text-muted text-sm">
        Price: @Model.Price.ToString("C") ·
        @(Model.Enrollable ? "Enrollable" : "Closed")
    </p>

    <form asp-action="Delete" style="margin-top:20px;display:flex;gap:12px">
        <input type="hidden" asp-for="ID" />
        <button type="submit" class="btn btn-danger">Delete Course</button>
        <a asp-action="Index" class="btn btn-outline">Cancel</a>
    </form>
</div>
