@model EduCore.ViewModels.QuestionFormViewModel
@{
    var quiz = (EduCore.Models.Quiz)ViewBag.Quiz;
    ViewData["Title"] = "Add Question";
}

<div class="page-header">
    <nav style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px">
        <a asp-controller="Quizzes" asp-action="Details" asp-route-id="@quiz.ID" style="color:var(--accent2);text-decoration:none">@quiz.Title</a>
        <span style="margin:0 8px">›</span>
        <span>Add Question</span>
    </nav>
    <h1 class="page-title">Add Question</h1>
    <p class="page-subtitle">Add a multiple-choice question to "@quiz.Title"</p>
</div>

<partial name="_QuestionForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
