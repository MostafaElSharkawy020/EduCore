@model IEnumerable<EduCore.Models.Course>
@{
    ViewData["Title"] = "Browse Courses";
    var enrolledIds = ViewBag.EnrolledIds as List<int> ?? new List<int>();
    var count = Model.Count();
}

<style>
    .search-bar-wrap { background:var(--primary); border-radius:16px; padding:32px; margin-bottom:28px; }
    .search-bar-wrap h2 { color:#fff; font-size:1.6rem; margin-bottom:16px; }
    .search-row { display:flex; gap:12px; }
    .search-input { flex:1; padding:11px 16px; border-radius:8px; border:none; font-family:'DM Sans',sans-serif; font-size:.95rem; outline:none; }
    .course-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(280px,1fr)); gap:20px; }
    .price-tag { font-size:1rem; font-weight:700; color:var(--accent); }
</style>

<div class="search-bar-wrap">
    <h2>Explore Our Courses</h2>
    <div class="search-row">
        <input type="text" class="search-input" id="search-input" placeholder="Search courses or teachers…" oninput="filterCourses()">
    </div>
</div>

<div class="flex-between mb-16">
    <span style="font-size:.9rem;color:var(--text-muted)" id="result-count">Showing @count course@(count == 1 ? "" : "s")</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No courses are open for enrollment right now. Check back soon.</div>
}
else
{
    <div class="course-grid" id="course-grid">
        @foreach (var course in Model)
        {
            var teacherName = $"{course.Teacher?.FName} {course.Teacher?.LName}".Trim();
            var enrolled = enrolledIds.Contains(course.ID);
            <div class="course-card course-item" data-search="@($"{course.Name} {teacherName}".ToLower())">
                <a asp-action="Details" asp-route-id="@course.ID" style="text-decoration:none;display:block">
                    <div class="course-card-img" style="position:relative">
                        <svg width="44" height="44" fill="none" stroke="rgba(255,255,255,.25)" stroke-width="1.5" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                        @if (enrolled)
                        {
                            <div style="position:absolute;top:12px;right:12px"><span class="badge badge-green">Enrolled</span></div>
                        }
                    </div>
                </a>
                <div class="course-card-body">
                    <div class="course-card-title">
                        <a asp-action="Details" asp-route-id="@course.ID" style="text-decoration:none;color:inherit">@course.Name</a>
                    </div>
                    <div class="course-card-meta" style="margin-bottom:10px">
                        @(string.IsNullOrWhiteSpace(teacherName) ? "Instructor" : teacherName)
                    </div>
                    <div style="display:flex;align-items:center;justify-content:space-between">
                        <span class="price-tag">@course.Price.ToString("C")</span>
                        <span style="font-size:.78rem;color:var(--text-muted)">@course.Classes.Count classes · @course.StudentCourses.Count students</span>
                    </div>
                    @if (enrolled)
                    {
                        <a asp-controller="Learn" asp-action="Course" asp-route-id="@course.ID" class="btn btn-primary btn-full" style="margin-top:12px">Go to Course</a>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@course.ID" class="btn btn-primary btn-full" style="margin-top:12px">View &amp; Enroll</a>
                    }
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function filterCourses() {
            var q = document.getElementById('search-input').value.toLowerCase();
            var n = 0;
            document.querySelectorAll('.course-item').forEach(function (card) {
                var match = card.dataset.search.indexOf(q) !== -1;
                card.style.display = match ? '' : 'none';
                if (match) n++;
            });
            document.getElementById('result-count').textContent = 'Showing ' + n + ' course' + (n === 1 ? '' : 's');
        }
    </script>
}
