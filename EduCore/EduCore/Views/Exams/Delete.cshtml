@model EduCore.Models.Exam
@{
    ViewData["Title"] = "Delete Exam";
}

<div class="page-header">
    <nav style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px">
        <a asp-action="Index" asp-route-courseId="@Model.CourseID" style="color:var(--accent2);text-decoration:none">Exams</a>
        <span style="margin:0 8px">›</span>
        <span>Delete Exam</span>
    </nav>
    <h1 class="page-title">Delete Exam</h1>
</div>

<div class="card" style="max-width:560px">
    <div class="alert alert-warning">
        Are you sure you want to delete this exam? Its @Model.ExamQuestions.Count question(s) and their choices will also be deleted.
    </div>

    <h3 style="margin-bottom:6px">@Model.Title</h3>

    <form asp-action="Delete" style="margin-top:20px;display:flex;gap:12px">
        <input type="hidden" asp-for="ID" />
        <button type="submit" class="btn btn-danger">Delete Exam</button>
        <a asp-action="Index" asp-route-courseId="@Model.CourseID" class="btn btn-outline">Cancel</a>
    </form>
</div>
