@model EduCore.Models.Question
@{
    ViewData["Title"] = "Delete Question";
    var examId = (int)ViewBag.ExamId;
}

<div class="page-header">
    <nav style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px">
        <a asp-controller="Exams" asp-action="Details" asp-route-id="@examId" style="color:var(--accent2);text-decoration:none">Exam</a>
        <span style="margin:0 8px">›</span>
        <span>Delete Question</span>
    </nav>
    <h1 class="page-title">Delete Question</h1>
</div>

<div class="card" style="max-width:560px">
    <div class="alert alert-warning">
        Are you sure you want to delete this question and its choices? This cannot be undone.
    </div>

    <p style="font-weight:600">@Model.QuestionText</p>

    <form asp-action="Delete" style="margin-top:20px;display:flex;gap:12px">
        <input type="hidden" asp-for="ID" />
        <button type="submit" class="btn btn-danger">Delete Question</button>
        <a asp-controller="Exams" asp-action="Details" asp-route-id="@examId" class="btn btn-outline">Cancel</a>
    </form>
</div>
