@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    bool IsActive(string c, string a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action, a, StringComparison.OrdinalIgnoreCase);

    var displayName = User.Identity?.Name ?? "";
    var isTeacher = User.IsInRole("Teacher");
    var isStudent = User.IsInRole("Student");
    var role = isTeacher ? "Teacher" : (isStudent ? "Student" : "");
    var initials = string.Concat(
        displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    if (string.IsNullOrEmpty(initials)) initials = "U";
    var homeController = isTeacher ? "Dashboard" : "Learn";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — EduCore</title>
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
</head>
<body>
    <!-- Topnav -->
    <nav class="topnav">
        <button id="sidebarToggle" onclick="toggleSidebar()"
                style="background:none;border:none;cursor:pointer;color:white;display:none">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        </button>
        <a asp-controller="@homeController" asp-action="Index" class="topnav-brand">Edu<span>Core</span></a>
        <div class="topnav-spacer"></div>
        <span class="topnav-role">@role</span>
        <a asp-controller="Profile" asp-action="Index" class="topnav-avatar" title="@displayName">@initials</a>
        <form method="post" asp-controller="Account" asp-action="Logout" style="margin:0 0 0 14px">
            <button type="submit" class="btn btn-sm" style="background:rgba(255,255,255,.12);color:#fff">Logout</button>
        </form>
    </nav>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        @if (isTeacher)
        {
            <div class="sidebar-section">
                <div class="sidebar-label">Main</div>
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(IsActive("Dashboard", "Index") ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    Dashboard
                </a>
                <a asp-controller="Courses" asp-action="Index" class="sidebar-link @(IsActive("Courses", "Index") ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                    My Courses
                </a>
                <a asp-controller="Classes" asp-action="Index" class="sidebar-link @(IsActive("Classes", "Index") ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7" /><rect x="1" y="5" width="15" height="14" rx="2" ry="2" /></svg>
                    My Classes
                </a>
                <a asp-controller="Revenue" asp-action="Index" class="sidebar-link @(IsActive("Revenue", "Index") ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                    Revenue
                </a>
            </div>
            <div class="sidebar-section">
                <div class="sidebar-label">Create</div>
                <a asp-controller="Courses" asp-action="Create" class="sidebar-link @(IsActive("Courses", "Create") ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    New Course
                </a>
                <a asp-controller="Classes" asp-action="Create" class="sidebar-link @(IsActive("Classes", "Create") ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    New Class
                </a>
            </div>
        }
        else if (isStudent)
        {
            <div class="sidebar-section">
                <div class="sidebar-label">Main</div>
                <a asp-controller="Learn" asp-action="Index" class="sidebar-link @(string.Equals(controller, "Learn", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    My Courses
                </a>
                <a asp-controller="Catalog" asp-action="Index" class="sidebar-link @(string.Equals(controller, "Catalog", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Browse Courses
                </a>
            </div>
        }
        <div class="sidebar-section">
            <div class="sidebar-label">Account</div>
            @if (isStudent)
            {
                <a asp-controller="Cards" asp-action="Index"
                   class="sidebar-link @(string.Equals(controller, "Cards", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
                    Payment Cards
                </a>
            }
            <a asp-controller="Profile" asp-action="Index"
               class="sidebar-link @(string.Equals(controller, "Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Profile
            </a>
        </div>
    </aside>

    <!-- Main -->
    <main class="main-content">
        <div class="page-inner">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        function toggleSidebar() { document.getElementById('sidebar')?.classList.toggle('open'); }
        (function () {
            var t = document.getElementById('sidebarToggle');
            if (!t) return;
            var mq = window.matchMedia('(max-width: 768px)');
            t.style.display = mq.matches ? 'block' : 'none';
            mq.addEventListener('change', function (e) { t.style.display = e.matches ? 'block' : 'none'; });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
